# =============================================================================
# 本地 test 环境（复制为 .env.test，勿提交 git）
# 用途：本机跑后端，连接主服务器 Supabase + MinIO（真实数据）
# 生成：pnpm setup:env:test
# 启动：pnpm dev:test（自动建 MinIO SSH 隧道）
# 文档：docs/ENV.md#本地-test-环境
# =============================================================================

# ---------- 数据库 / 认证（与主服务器一致，由 setup:env:test 从远端拉取）----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
# SUPABASE_DB_URL=postgresql://...

JWT_SECRET=sync-from-main-server
JWT_ACCESS_TOKEN_EXPIRES_IN=57600
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
JWT_CLOCK_TOLERANCE_SECONDS=120
ADMIN_TOKEN=sync-from-main-server

# ---------- MinIO（经 SSH 隧道，见 scripts/test-env-tunnel.sh）----------
# 主服务器 MinIO 仅监听 127.0.0.1:9000，本地通过隧道映射到 19000
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sync-from-main-server
MINIO_SECRET_KEY=sync-from-main-server
MINIO_REGION=us-east-1

# ---------- 三块对象存储（与主服务器一致）----------
CGI_STORAGE_BUCKET=aigc
STORAGE_GENERATED_PROVIDER=minio
STORAGE_GENERATED_BUCKET=aigc
STORAGE_GENERATED_ACCESS=proxy

STORAGE_USER_UPLOAD_PROVIDER=minio
STORAGE_USER_UPLOAD_BUCKET=user-assets
STORAGE_USER_UPLOAD_ACCESS=proxy

STORAGE_SYSTEM_STATIC_PROVIDER=minio
STORAGE_SYSTEM_STATIC_BUCKET=system-assets
STORAGE_SYSTEM_STATIC_ACCESS=proxy

# 本地 Gateway 代理媒体；勿指向生产 IP
PUBLIC_GATEWAY_ORIGIN=http://localhost:3000
PUBLIC_GATEWAY_ABSOLUTE_URLS=0
R2_BUCKET=user-assets

# ---------- 本机 Redis（与 dev 相同，不连远端）----------
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- 各服务端口（本机）----------
GATEWAY_PORT=3000
MXMAUTH_PORT=4001
MXMPAY_PORT=4002
MXMCGI_PORT=4003
WORKER_PORT=4004
SCHEDULER_PORT=4006
MXMNOTIFY_PORT=4005

# ---------- Gateway / 服务互调（本机）----------
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:5173,http://localhost:5174,http://localhost:5200
MXMAUTH_URL=http://localhost:4001
MXMPAY_URL=http://localhost:4002
MXMCGI_URL=http://localhost:4003
MXMNOTIFY_URL=http://localhost:4005
# 同机 PPTX 编译微服务
PPTX_COMPILER_URL=http://127.0.0.1:4010
PPTX_COMPILER_PORT=4010
PPTX_COMPILER_WORKERS=4

# ---------- mxmcgi ----------
MXMCGI_ROLE=all
CAPTCHA_ENABLE=false
DEFAULT_PROVIDER=replicate

# AI Provider Keys（setup:env:test 会从主服务器同步；按需保留或删除）
# REPLICATE_API_TOKEN=
# MAXPLAN_API_KEY=

# ---------- 可选覆盖（.env.test.local，已 gitignore）----------
# MINIO_TUNNEL_LOCAL_PORT=19000
# DEPLOY_HOST=root@121.43.32.168
