  },
  "dependencies": {
    "@mxmai/mxmdata": "workspace:*",
    "axios": "^1.13.2",
    "ioredis": "^5.8.2",
    "svg-captcha": "^1.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "vitest": "^4.0.13"
  }
}
