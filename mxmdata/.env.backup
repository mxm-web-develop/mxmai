# 数据访问层配置
DATA_ADAPTER=postgresql

# PostgreSQL 配置（使用本地 Docker 服务）
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mxmai
PG_USER=postgres
PG_PASSWORD=postgres

# MinIO 配置（使用本地 Docker 服务）
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1