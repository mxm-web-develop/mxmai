# mxmdata 环境变量配置
# 复制此文件为 .env 并填入实际配置

# 数据适配器选择: supabase 或 postgresql
DATA_ADAPTER=supabase

# ============================================
# Supabase 配置（当 DATA_ADAPTER=supabase 时）
# ============================================
# 
# 方式一：使用 Supabase 云服务（推荐用于生产环境）
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key
#
# 方式二：使用本地 Supabase（推荐用于开发环境）
# 本地 Supabase 使用 PostgREST 作为 API 入口
SUPABASE_URL=http://localhost:3000
# 本地开发可以使用以下默认密钥（生产环境请使用强密钥）
# 生成方式：运行 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ============================================
# PostgreSQL 配置（当 DATA_ADAPTER=postgresql 时）
# ============================================
# 注意：当前代码只支持 Supabase 适配器，不支持直接使用 PostgreSQL
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=mxmai
# PG_USER=postgres
# PG_PASSWORD=postgres

# ============================================
# MinIO 对象存储配置
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=
