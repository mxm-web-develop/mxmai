# 数据访问层配置
DATA_ADAPTER=supabase

# Supabase 配置
# 本地开发使用本地 Supabase 服务（通过 docker-compose 启动）
# PostgREST 运行在端口 3000，作为 Supabase API 入口
SUPABASE_URL=http://localhost:3001

# 本地 Supabase 默认密钥（仅用于开发环境）
# 生产环境请使用强密钥
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Supabase 本地开发默认的 anon key（用于客户端访问）
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTYsImlhdCI6MTc2NDA1ODYyNX0.vtvxlPlmXKdGTBCUIbz7gYiJmot9Io27S_vVefHgVtY
# Supabase 本地开发默认的 service_role key（用于服务端访问，有更高权限）
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5NiwiaWF0IjoxNzY0MDU4NjI1fQ.sXwJjgolhqphoWNeiAIPGey0FLSp_--HIBQPj9NJN50

# MinIO 配置（使用本地 Docker 服务）
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

