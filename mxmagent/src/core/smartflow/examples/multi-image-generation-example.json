{
  "name": "多图生成智能链示例",
  "description": "展示如何在智能链中使用多张图片输入（seedream-4支持多参考图片）",
  "schema": {
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "input": [
          {
            "name": "reference_images",
            "type": "image",
            "description": "参考图片数组（1-10张，支持base64或URL）"
          },
          {
            "name": "prompt",
            "type": "text",
            "description": "生成提示词"
          }
        ],
        "expected_outputs": [
          {
            "type": "image",
            "name": "generated_image",
            "required": true
          }
        ],
        "smartflow_name": "多图参考生成工作流"
      },
      {
        "id": "generate_image",
        "type": "model",
        "model_type": "image",
        "model": "seedream-4",
        "prompt": "{{input.prompt}}",
        "params": {
          "image_input": "{{input.reference_images}}",
          "size": "2K"
        }
      },
      {
        "id": "end",
        "type": "end",
        "output_mapping": {
          "generated_image": "{{generate_image.image_urls}}"
        },
        "validate_outputs": true
      }
    ],
    "edges": [
      { "from": "start", "to": "generate_image" },
      { "from": "generate_image", "to": "end" }
    ]
  }
}
