{
  "name": "@mxmai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MXM AI Collection",
  "scripts": {
    "dev:mxmauth": "pnpm --filter @mxmai/mxmauth dev",
    "build:mxmauth": "pnpm --filter @mxmai/mxmauth build",
    "start:mxmauth": "pnpm --filter @mxmai/mxmauth start",
    "dev:mxmpay": "pnpm --filter @mxmweb/mxmpay dev",
    "build:mxmpay": "pnpm --filter @mxmweb/mxmpay build",
    "start:mxmpay": "pnpm --filter @mxmweb/mxmpay start",
    "dev:mxmcgi": "pnpm --filter @mxmai/mxmcgi dev",
    "dev:mxmcgi:api": "pnpm --filter @mxmai/mxmcgi dev:api",
    "dev:mxmcgi:worker": "pnpm --filter @mxmai/mxmcgi dev:worker",
    "dev:mxmcgi:split": "pnpm --filter @mxmai/mxmcgi dev:split",
    "dev:pptx-compiler": "cd mxmcgi/tools/pptx-compiler && PPTX_COMPILER_HOST=127.0.0.1 PPTX_COMPILER_PORT=4010 python3 server.py",
    "build:mxmcgi": "pnpm --filter @mxmai/mxmcgi build",
    "start:mxmcgi": "pnpm --filter @mxmai/mxmcgi start",
    "start:mxmcgi:api": "MXMCGI_ROLE=api pnpm --filter @mxmai/mxmcgi start",
    "start:mxmcgi:worker": "pnpm --filter @mxmai/mxmcgi start:worker",
    "dev:mxmnotify": "pnpm --filter @mxmai/mxmnotify dev",
    "build:mxmnotify": "pnpm --filter @mxmai/mxmnotify build",
    "start:mxmnotify": "pnpm --filter @mxmai/mxmnotify start",
    "dev:gateway": "pnpm --filter @mxmai/gateway dev",
    "build:gateway": "pnpm --filter @mxmai/gateway build",
    "start:gateway": "pnpm --filter @mxmai/gateway start",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "build:prod": "bash scripts/build-prod.sh",
    "deploy:server": "bash scripts/deploy-to-server.sh",
    "deploy:hk": "bash scripts/deploy-hk-server.sh",
    "migrate:hz-to-hk": "bash scripts/migrate-hangzhou-to-hongkong.sh",
    "sync:funasr-cache": "bash scripts/sync-funasr-modelscope-cache.sh",
    "fix:hk-ssh": "bash scripts/fix-hk-ssh-direct.sh",
    "seed:video-edit:production": "bash scripts/seed-video-edit-production.sh",
    "sync:provider-db": "bash scripts/sync-provider-db-production.sh",
    "probe:provider-model": "pnpm --filter @mxmai/mxmcgi run probe:provider-model --",
    "upsert:provider-pricing": "pnpm --filter @mxmai/mxmcgi run upsert:provider-pricing --",
    "deploy:h5-china": "bash scripts/deploy-h5-china.sh",
    "deploy:admin-china": "bash scripts/deploy-admin-china.sh",
    "setup:domain-mxm-ai": "bash scripts/setup-domain-mxm-ai.sh",
    "setup:ssl-hk": "bash scripts/setup-ssl-hk.sh",
    "start:prod": "pm2 start scripts/ecosystem.config.cjs",
    "dev:eshop-h5": "pnpm --filter eshop-agentic-h5 dev",
    "build:eshop-h5": "pnpm --filter eshop-agentic-h5 build",
    "dev:mxmdata": "pnpm --filter @mxmai/mxmdata dev",
    "build:mxmdata": "pnpm --filter @mxmai/mxmdata build",
    "ensure:buckets": "pnpm --filter @mxmai/mxmcgi exec tsx ../mxmdata/src/scripts/ensure-storage-buckets.ts",
    "start:mxmdata": "pnpm --filter @mxmai/mxmdata start",
    "clear:ports": "bash scripts/clear-ports.sh",
    "dev:all": "(test -f mxmdata/dist/index.js || pnpm --filter @mxmai/mxmdata run build:dist) && pnpm clear:ports && concurrently \"pnpm dev:mxmauth\" \"pnpm dev:mxmpay\" \"pnpm dev:mxmcgi:split\" \"pnpm dev:mxmnotify\" \"pnpm dev:gateway\" \"pnpm dev:pptx-compiler\" --names \"mxmauth,mxmpay,mxmcgi,mxmnotify,gateway,pptx\" --prefix-colors \"blue,yellow,cyan,magenta,green,white\"",
    "dev:all-with-web": "concurrently \"pnpm run dev:all\" \"bash scripts/wait-for-gateway.sh && CLEAR_WEB_ONLY=1 WEB_DEV_PORT=5200 bash scripts/clear-ports.sh && WEB_DEV_PORT=5200 pnpm run dev:web\" --names \"backend,web\" --prefix-colors \"blue,green\"",
    "setup:env:test": "bash scripts/setup-env-test.sh",
    "tunnel:test": "bash scripts/test-env-tunnel.sh",
    "dev:test": "bash scripts/dev-test.sh",
    "start:all": "concurrently \"pnpm start:mxmauth\" \"pnpm start:mxmcgi:api\" \"pnpm start:mxmcgi:worker\" \"pnpm start:mxmnotify\" \"pnpm start:gateway\" --names \"mxmauth,mxmcgi-api,mxmcgi-worker,mxmnotify,gateway\" --prefix-colors \"blue,cyan,cyan,magenta,green\"",
    "init:project": "tsx ./init-project.ts",
    "sync:config-to-cloud": "tsx scripts/sync-config-to-cloud.ts",
    "sync:compare-config": "tsx scripts/compare-config-local-cloud.ts",
    "embedding:systemkb": "tsx embedding-systemkb.ts",
    "seed:prompt-config": "pnpm --filter @mxmai/mxmcgi run seed:prompt-config",
    "sync:agent-skill": "bash scripts/sync-agent-skill.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:visual": "tsx scripts/run-e2e-visual-test.ts",
    "playwright:install": "playwright install"
  },
  "keywords": [
    "Ai",
    "AI Collection",
    "MXM",
    "MXM AI Collection"
  ],
  "resolutions": {
    "styled-components": "^6"
  },
  "author": "hanfeng_Zhang",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "@types/minio": "^7.1.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "sharp": "^0.34.5",
    "uid": "^2.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/ui": "^4.0.13",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}