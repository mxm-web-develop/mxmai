{
  "name": "@mxmai/mxm-editor-core",
  "version": "0.1.0",
  "private": true,
  "description": "supermxmai 视频时间轴编辑器核心 — 完整移植自 OpenReel packages/core (MIT, 187 个 TS 模块, 涵盖 types/utils/actions/storage/timeline/media/video/audio/text/graphics/effects/animation/editing-templates/photo/template/ai/device/playback/export)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "import": "./src/types/*.ts",
      "default": "./src/types/*.ts"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "import": "./src/utils/*.ts",
      "default": "./src/utils/*.ts"
    },
    "./storage/*": {
      "types": "./src/storage/*.ts",
      "import": "./src/storage/*.ts",
      "default": "./src/storage/*.ts"
    },
    "./actions": {
      "types": "./src/actions/index.ts",
      "import": "./src/actions/index.ts",
      "default": "./src/actions/index.ts"
    },
    "./timeline": {
      "types": "./src/timeline/index.ts",
      "import": "./src/timeline/index.ts",
      "default": "./src/timeline/index.ts"
    },
    "./media/*": {
      "types": "./src/media/*.ts",
      "import": "./src/media/*.ts",
      "default": "./src/media/*.ts"
    },
    "./effects": {
      "types": "./src/effects/index.ts",
      "import": "./src/effects/index.ts",
      "default": "./src/effects/index.ts"
    },
    "./ai": {
      "types": "./src/ai/index.ts",
      "import": "./src/ai/index.ts",
      "default": "./src/ai/index.ts"
    },
    "./device": {
      "types": "./src/device/index.ts",
      "import": "./src/device/index.ts",
      "default": "./src/device/index.ts"
    },
    "./animation": {
      "types": "./src/animation/index.ts",
      "import": "./src/animation/index.ts",
      "default": "./src/animation/index.ts"
    },
    "./text": {
      "types": "./src/text/index.ts",
      "import": "./src/text/index.ts",
      "default": "./src/text/index.ts"
    },
    "./graphics": {
      "types": "./src/graphics/index.ts",
      "import": "./src/graphics/index.ts",
      "default": "./src/graphics/index.ts"
    },
    "./template": {
      "types": "./src/template/index.ts",
      "import": "./src/template/index.ts",
      "default": "./src/template/index.ts"
    },
    "./editing-templates": {
      "types": "./src/editing-templates/index.ts",
      "import": "./src/editing-templates/index.ts",
      "default": "./src/editing-templates/index.ts"
    },
    "./photo": {
      "types": "./src/photo/index.ts",
      "import": "./src/photo/index.ts",
      "default": "./src/photo/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "npm run build:wasm:fft && npm run build:wasm:wav && npm run build:wasm:beat",
    "build:wasm:fft": "asc src/wasm/fft/assembly/index.ts -o src/wasm/fft/build/fft.wasm --optimize --runtime stub",
    "build:wasm:wav": "asc src/wasm/wav/assembly/index.ts -o src/wasm/wav/build/wav.wasm --optimize --runtime stub",
    "build:wasm:beat": "asc src/wasm/beat-detection/assembly/index.ts -o src/wasm/beat-detection/build/beat.wasm --optimize --runtime stub"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediapipe/tasks-vision": "^0.10.35",
    "gsap": "^3.14.2",
    "idb-keyval": "^6.2.2",
    "immer": "^11.0.1",
    "mediabunny": "^1.25.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0",
    "assemblyscript": "^0.27.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "credits": "代码全部来自 https://github.com/Augani/openreel-video (MIT) — supermxmai 维护 fork 集成版本"
}
