# 国内 H5 生产构建示例（复制为 .env 后本地 build，勿提交 git）
NEXT_PUBLIC_API_MODE=http
# 留空：浏览器走同源 /api，由 Next rewrites 反代到 OPEN_API_PROXY_TARGET
NEXT_PUBLIC_OPEN_API_BASE=
NEXT_PUBLIC_OPEN_API_USE_PROXY=true

# Next 服务端 /api 反代目标（杭州主力 Gateway 公网 IP 或域名）
OPEN_API_PROXY_TARGET=https://mxm-ai.com

# 开放 API integration Key（账号中心创建）
MXMTOKEN=mxm_your_integration_key_here
