{
  "slug": "eshop-batch-studio",
  "title": "批量商拍工作流",
  "description": "1 组模特 + N 款 SKU 批量出图",
  "kind": "smartflow",
  "schemaVersion": 1,
  "inputSchema": {
    "type": "object",
    "required": ["model_images", "garments"],
    "properties": {
      "model_images": {
        "type": "array",
        "title": "模特参考",
        "minItems": 1,
        "maxItems": 3,
        "x-ui-type": "referenceImages",
        "items": {
          "type": "object",
          "properties": {
            "content": { "type": "string" },
            "type": { "type": "string", "default": "main-subject" }
          }
        }
      },
      "garments": {
        "type": "array",
        "title": "服装 SKU 批次",
        "minItems": 1,
        "maxItems": 12,
        "x-ui-type": "eshopGarmentBatch",
        "items": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "images": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "content": { "type": "string" },
                  "type": { "type": "string", "default": "outfits" }
                }
              }
            },
            "shoot_preset": { "type": "string" },
            "prompt": { "type": "string" }
          }
        }
      },
      "shoot_preset_mode": {
        "type": "string",
        "title": "场景模式",
        "default": "auto",
        "enum": ["auto", "fixed"],
        "enumNames": ["智能规划", "固定场景"],
        "x-ui-type": "selection"
      },
      "shoot_preset_fixed": {
        "type": "string",
        "title": "固定场景",
        "default": "studio_soft_gray",
        "enum": ["studio_soft_gray", "beach_sunny_pier", "urban_street"],
        "enumNames": ["棚拍柔灰", "海边栈道", "城市街拍"],
        "x-ui-type": "selection"
      },
      "output_grid": {
        "type": "string",
        "title": "输出布局",
        "default": "1x1",
        "enum": ["1x1", "2x2"],
        "enumNames": ["单图", "四宫格"],
        "x-ui-type": "selection"
      }
    }
  },
  "inputDoc": {
    "fieldHints": {
      "garments": "每款 1～3 张参考图，支持 SKU 标签"
    }
  }
}
