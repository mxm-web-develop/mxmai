# mock | http（有 MXMTOKEN 时 next.config 默认 http）
NEXT_PUBLIC_API_MODE=http

# Gateway 由打包/部署决定（用户不可在 App 内修改）
# 留空：浏览器走同源 /api，由 Next rewrites 反代 OPEN_API_PROXY_TARGET
NEXT_PUBLIC_OPEN_API_BASE=
NEXT_PUBLIC_OPEN_API_USE_PROXY=true
# Next 服务端 /api 反代目标（本地 dev 默认 localhost:3000）
OPEN_API_PROXY_TARGET=http://localhost:3000

# 服务端 integration Key（勿提交 git；H5 BFF 换票用，不暴露给浏览器）
MXM_PARTNER_KEY=mxm_your_integration_key_here

# Partner 短信登录（验证码由 mxmauth + 阿里云短信认证下发；H5 侧无需 PARTNER_SMS_*）
# 开发 mock：根目录 .env 设 PARTNER_SMS_MOCK=true 时 BFF 返回 debugCode=123456
