{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "documentRenderSpec.v1",
  "type": "object",
  "required": ["version", "page", "theme", "blocks"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "const": "1" },
    "page": {
      "type": "object",
      "required": ["size"],
      "additionalProperties": false,
      "properties": {
        "size": { "type": "string", "enum": ["A4", "Letter"] },
        "margin": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 4,
          "maxItems": 4
        },
        "backgroundImage": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "required": ["paletteId", "designStyle"],
      "additionalProperties": false,
      "properties": {
        "paletteId": { "type": "string", "minLength": 1 },
        "designStyle": { "type": "string", "minLength": 1 },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "body": { "type": "string" },
            "caption": { "type": "string" }
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "text": { "type": "string" },
            "muted": { "type": "string" },
            "background": { "type": "string" }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "role": { "type": "string", "enum": ["profile", "cover", "background", "logo", "other"] }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/block" }
    },
    "layoutHtml": { "type": "string" }
  },
  "definitions": {
    "block": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cover", "toc", "section", "markdown", "image", "highlights", "twoColumn", "spacer"]
        },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "style": { "type": "string" },
        "contentBinding": { "type": "string" },
        "assetId": { "type": "string" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 6 },
        "height": { "type": "number", "minimum": 0 },
        "left": { "type": "array", "items": { "$ref": "#/definitions/block" } },
        "right": { "type": "array", "items": { "$ref": "#/definitions/block" } },
        "items": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
