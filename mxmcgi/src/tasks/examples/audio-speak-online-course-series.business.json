      "rules_i18n": { "zh": "", "en": "" },
      "output_format_i18n": { "zh": "", "en": "" },
      "form_options_i18n": null,
      "extra": {
        "display": {
          "taskLabel": "音频 · 网络课程口播",
          "subtypeLabel": "基于文档/说明书的网络课单期口播（术语表+大纲+讲稿+TTS），适合多期系列"
        },
        "taskTemplate": {
          "formSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": ["course_title", "source_material"],
            "properties": {
              "course_title": {
                "type": "string",
                "title": "系列名 / 课名",
                "description": "系列品牌，写入每期开场和下期预告",
                "minLength": 1,
                "maxLength": 50
              },
              "episode_index": {
                "type": "integer",
                "title": "期数",
                "minimum": 1,
                "default": 1
              },
              "episode_title": {
                "type": "string",
                "title": "本期主题",
                "description": "留空会在大纲阶段自动从源材料提炼",
                "maxLength": 50
              },
              "host_name": {
                "type": "string",
                "title": "讲师 / UP 主名",
                "description": "可空，留空时以「讲师」占位",
                "maxLength": 30
              },
              "target_audience": {
                "type": "string",
                "title": "目标受众",
                "x-ui-type": "selection",
                "enum": ["general", "tech", "finance_biz", "academic", "kids", "senior"],
                "x-enum-labels": ["通用大众", "技术从业者", "金融/商业人士", "学术研究", "青少年儿童", "老年群体"],
                "default": "general",
                "description": "决定术语密度、类比、节奏；kids 偏慢多用类比；senior 句子短"
              },
              "course_topic_blurb": {
                "type": "string",
                "title": "课程一句话介绍",
                "description": "讲什么、为何值得听；进入开场叙述",
                "maxLength": 200
              },
              "course_tone": {
                "type": "string",
                "title": "课程语气基调",
                "x-ui-type": "selection",
                "enum": ["steady", "editorial", "narrative", "explanatory", "lively", "passionate"],
                "x-enum-labels": ["沉稳理性", "评论思辨", "故事叙事", "教练拆解", "轻松活泼", "激情澎湃"],
                "default": "explanatory"
              },
              "language": {
                "type": "string",
                "title": "课程语言",
                "x-ui-type": "selection",
                "enum": ["zh", "en"],
                "x-enum-labels": ["中文", "English"],
                "default": "zh"
              },
              "episode_target_minutes": {
                "type": "integer",
                "title": "本期目标时长（分钟，硬上限 20）",
                "x-ui-type": "number",
                "minimum": 3,
                "maximum": 20,
                "default": 12,
                "description": "源文档内容密度自动影响实际节数与时长；超出 20 分钟系统会自动压缩而非延期"
              },
              "course_gloss_enabled": {
                "type": "boolean",
                "title": "讲稿中插入术语口语化释义",
                "description": "关闭则跳过术语抽取步骤；推荐保持开启",
                "default": true
              },
              "source_material": {
                "type": "string",
