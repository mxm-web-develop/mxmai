                "type": "integer",
                "title": "预估时长（秒，计费参考）",
                "minimum": 1,
                "default": 720,
                "x-user-visible": false
              }
            }
          },
          "uiSchema": {
            "source_material": { "ui:options": { "rows": 10 } },
            "supplement": { "ui:widget": "textarea", "ui:options": { "rows": 3 } }
          },
          "prompt": {
            "unifiedTemplate": "【课程元数据占位 - 由 6 步 pipeline 产出最终 prompt】\n\n课程名：${course_title}\n期数：${episode_index}\n本期主题：${episode_title}\n目标受众：${target_audience}\n语气：${course_tone}\n语言：${language}\n目标时长：${episode_target_minutes} 分钟\n术语表开启：${course_gloss_enabled}\n\n开场主题：${course_topic_blurb}\n源文档：${source_material}\n补充：${supplement}\n\n最终 prompt 由 pre 末段（TTS markup）输出。"
          },
          "storage": {
            "scope": "audio",
            "extension": "mp3",
            "mime": "audio/mpeg",
            "pathTemplate": "{userId}/audio/course/{timestamp}-{randomId}/",
            "filenameTemplate": "course_{taskId}_{randomId}.mp3"
          },
          "pipeline": {
            "pre": [
              {
                "step": "nestedText",
                "nestedTextTaskKey": "text/transform/course-glossary-extract",
                "params": { "afterPromptRender": true, "outputStatePath": "courseGlossaryJson" },
                "inputMapping": {
                  "source_material": "${params.source_material}",
                  "language": "${params.language}"
                },
                "when": { "all": [{ "field": "params.course_gloss_enabled", "op": "truthy" }] }
              },
              {
                "step": "nestedText",
                "nestedTextTaskKey": "text/transform/course-outline-from-doc",
                "params": { "afterPromptRender": true },
                "inputMapping": {
                  "course_title": "${params.course_title}",
                  "episode_index": "${params.episode_index}",
                  "episode_title": "${params.episode_title}",
                  "target_audience": "${params.target_audience}",
                  "course_topic_blurb": "${params.course_topic_blurb}",
                  "course_tone": "${params.course_tone}",
                  "language": "${params.language}",
                  "episode_target_minutes": "${params.episode_target_minutes}",
                  "course_glossary_json": "${state.courseGlossaryJson}",
                  "source_material": "${params.source_material}",
                  "supplement": "${params.supplement}"
                }
              },
              {
                "step": "manualReview",
                "params": {
                  "id": "course-outline-review",
                  "label": "课程大纲审核",
                  "hint": "本期 5-8 节课程结构；可增删节、调整 teaching_objectives；确认后进入讲稿撰写。",
                  "kind": "text",
                  "draftFrom": "${state.finalPrompt}",
                  "applyMapping": { "prompt": "${review.text}" }
                }
              },
              {
                "step": "nestedText",
                "nestedTextTaskKey": "text/transform/course-lecture-script-draft",
                "params": { "afterPromptRender": true },
                "inputMapping": {
                  "course_title": "${params.course_title}",
                  "episode_index": "${params.episode_index}",
                  "course_tone": "${params.course_tone}",
                  "target_audience": "${params.target_audience}",
                  "course_glossary_json": "${state.courseGlossaryJson}",
                  "episode_outline_json": "${state.finalPrompt}",
                  "language": "${params.language}"
                }
              },
              {
                "step": "manualReview",
                "params": {
                  "id": "course-lecture-review",
                  "label": "课程讲稿审核",
                  "hint": "本期完整逐节讲稿（Markdown，开头 hook + s1…sN 节 + 总结 + 下期预告）；总时长上限 20 分钟。确认后进入 TTS 优化与合成。",
                  "kind": "text",
                  "draftFrom": "${state.finalPrompt}",
                  "applyMapping": { "prompt": "${review.text}" }
                }
              },
              {
                "step": "nestedText",
                "nestedTextTaskKey": "text/transform/course-lecture-tts-markup",
                "params": { "afterPromptRender": true },
                "inputMapping": {
                  "script_draft": "${state.finalPrompt}",
                  "voice_id": "${params.voice_id}",
                  "course_tone": "${params.course_tone}",
                  "speech_rhythm": "${params.speech_rhythm}",
                  "target_audience": "${params.target_audience}",
                  "language": "${params.language}"
                }
              }
            ]
          },
          "extra": {
            "subtitle_enable": true
          }
        }
      },
      "routing": {
        "logical_model": "audio-speak-online-course-series",
