          "subtypeLabel": "从原文抽取 5-8 节课程结构，输出 JSON；可挂载为 audio/speak/online-course-series 管线第二步 nestedText"
        },
        "taskTemplate": {
          "formSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": ["course_title", "source_material"],
            "properties": {
              "course_title": {
                "type": "string",
                "title": "系列名 / 课名",
                "minLength": 1,
                "maxLength": 50
              },
              "episode_index": {
                "type": "integer",
                "title": "期数",
                "minimum": 1,
                "default": 1
              },
              "episode_title": {
                "type": "string",
                "title": "本期主题",
                "description": "本期要解决的核心问题；留空则在大纲阶段自动从源材料提炼",
                "maxLength": 50
              },
              "target_audience": {
                "type": "string",
                "title": "目标受众",
                "x-ui-type": "selection",
                "enum": ["general", "tech", "finance_biz", "academic", "kids", "senior"],
                "x-enum-labels": ["通用大众", "技术从业者", "金融/商业人士", "学术研究", "青少年儿童", "老年群体"],
                "default": "general",
                "description": "影响术语密度、类比风格、节奏；kids 类偏慢、多类比；academic 类偏快、术语原貌"
              },
              "course_topic_blurb": {
                "type": "string",
                "title": "课程一句话介绍",
                "description": "课程是关于什么的、受众是谁、为何值得听；进入开场叙述",
                "maxLength": 200
              },
              "course_tone": {
                "type": "string",
                "title": "课程语气基调",
                "x-ui-type": "selection",
                "enum": ["steady", "editorial", "narrative", "explanatory", "lively", "passionate"],
                "x-enum-labels": ["沉稳理性", "评论思辨", "故事叙事", "教练拆解", "轻松活泼", "激情澎湃"],
                "default": "explanatory"
              },
              "language": {
                "type": "string",
                "title": "课程语言",
                "x-ui-type": "selection",
                "enum": ["zh", "en"],
                "x-enum-labels": ["中文", "English"],
                "default": "zh"
              },
              "episode_target_minutes": {
                "type": "integer",
                "title": "本期目标时长（分钟，建议≤20）",
                "x-ui-type": "number",
                "minimum": 3,
                "maximum": 20,
                "default": 12
              },
              "course_glossary_json": {
                "type": "string",
                "title": "系列术语表（来自第一步）",
                "description": "上游 nestedText 输出的 JSON 字符串，将由 pipeline 注入",
                "default": "[]"
              },
              "source_material": {
                "type": "string",
                "title": "源文档",
                "minLength": 1,
                "x-ui-type": "textFileOrPaste",
                "x-max-chars": 120000
              },
              "supplement": {
                "type": "string",
                "title": "补充要求",
                "description": "可选：必讲名词、必须规避、强调角度等"
              }
            }
          },
          "prompt": {
            "unifiedTemplate": "你是【${language}】网络课编辑，根据源文档内容裂解为本期课程的**结构化大纲**。\n\n【课程元数据】\n课程名：${course_title}\n期数：第 ${episode_index} 期\n本期主题：${episode_title}\n目标受众：${target_audience}\n  general=通用大众；tech=技术从业者（保留英文术语，节奏快）；\n  finance_biz=金融/商业人士（偏战略与案例数据）；academic=学术研究（严谨、保留术语原文）；\n  kids=青少年儿童（类比多、节奏慢、忌讳抽象）；senior=老年群体（句子短、口齿清晰、忌讳网络词）\n课程语气：${course_tone}（steady/editorial/narrative/explanatory/lively/passionate）\n课程介绍：${course_topic_blurb}\n本期目标时长：${episode_target_minutes} 分钟\n\n【本期系列术语表（参考）】\n${course_glossary_json}\n\n【源文档】\n${source_material}\n\n【任务】\n1. 按源文档**实际信息密度**确定本期的**节数**：5-8 节为宜；源文档 < 3000 字可 ≤4 节；> 8000 字可到 8 节。\n2. **每节是一节可独立听懂的「知识点」**，不是源文档的章节名直接复用。\n3. 本期总口播时长（含开头 hook）目标 ${episode_target_minutes} 分钟，但**不超过 20 分钟**（如源材料极大，自动压缩信息密度、剔除次要支线，而非延长时间）。\n4. 每节 `duration_seconds` 字段估算口播时长（目标 ×60 / 节数 ± 30s）；多节用 teaser 互相衔接，避免重复铺垫。\n5. 每节 `key_points` 3-5 条；要具体（数据、概念名、案例），不是「介绍…」「探讨…」。\n6. 每节 `teaser` 是 30 秒内的开场 hook 切入点（如反常识、痛点、悬念、一句话答案倒置）。\n\n【输出 - 严格的 JSON，无 Markdown 包裹】\n{\n  \"course_title\": \"${course_title}\",\n  \"episode_index\": ${episode_index},\n  \"episode_outline\": [\n    {\n      \"uid\": \"s1\",\n      \"title\": \"节标题（8-20 字）\",\n      \"teasing_seconds\": 30,\n      \"teaser\": \"节内 30 秒开场 hook 切入\",\n      \"teaching_objectives\": [\"听完能…\", \"能区分…\"],\n      \"key_points\": [\"要点 1\", \"要点 2\", \"要点 3\"],\n      \"case\": \"该节的具体案例或数据示例（无则 N/A）\",\n      \"duration_seconds\": 180,\n      \"depends_on\": []\n    }\n  ]\n}"
          },
          "extra": {
            "generateParams": {
              "temperature": 0.4,
              "maxTokens": 16384
            }
          }
        }
      },
      "routing": {
        "logical_model": "text-transform-course-outline-from-doc",
        "provider": "maxplan",
        "model": "MiniMax-M3",
        "enabled": true,
        "sensitive_word_lists": []
