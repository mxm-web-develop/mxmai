          "subtypeLabel": "productposter（产品/表单锁死 + 电商上屏字）",
          "taskLabelI18n": {
            "zh": "设计 · 产品宣传海报",
            "zh-TW": "設計 · 產品宣上傳海報"
          },
          "subtypeLabelI18n": {
            "zh": "productposter（产品/表单锁死 + 电商上屏字）",
            "zh-TW": "productposter（產品/表單锁死 + 电商上屏字）"
          }
        },
        "promptTextTaskKey": "text/format/gpt-image-2",
        "taskTemplate": {
          "extra": {
            "generateParams": {
              "maxTokens": 20000,
              "temperature": 0.35
            }
          },
          "knowledge": {
            "strategy": "global",
            "useKnowledge": false,
