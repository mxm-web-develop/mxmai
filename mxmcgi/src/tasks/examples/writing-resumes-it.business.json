              },
              "tech_stack_other": {
                "type": "string",
                "title": "其他技术栈（可选）",
                "x-ui-type": "textarea",
                "x-min-rows": 2,
                "x-max-rows": 8
              },
              "experience_raw": {
                "type": "string",
                "title": "工作经历（原始）",
                "minLength": 1,
                "x-ui-type": "textarea",
                "x-min-rows": 10,
                "x-max-rows": 24
              },
              "past_projects": {
                "type": "string",
                "title": "过往项目",
                "description": "可选。补充项目背景、职责、技术栈与成果；与工作经历可分开填写。",
                "x-ui-type": "textarea",
                "x-min-rows": 8,
                "x-max-rows": 24
              },
              "job_description": {
                "type": "string",
                "title": "目标 JD（可选）",
                "x-ui-type": "textarea",
                "x-min-rows": 6,
                "x-max-rows": 16
              },
              "design_style": {
                "type": "string",
                "title": "PDF 设计风格",
                "enum": [
                  "modern_sidebar",
                  "classic_onesheet",
                  "minimal_clean",
                  "tech_blue",
                  "compact_dense"
                ],
                "x-enum-labels": [
                  "现代侧栏",
                  "经典单页",
                  "极简",
                  "科技蓝",
                  "紧凑密集"
                ],
                "default": "modern_sidebar",
                "x-ui-type": "selection"
              },
              "pdf_renderer": {
                "type": "string",
                "title": "渲染方案",
                "enum": [
                  "markdown",
                  "styled",
                  "html"
                ],
                "x-enum-labels": [
                  "快速",
                  "普通",
                  "精美"
                ],
                "default": "styled",
                "x-ui-type": "selection"
              },
              "profile_photo": {
                "type": "array",
                "title": "头像",
                "maxItems": 1,
                "x-ui-type": "referenceImages",
                "items": {
                  "type": "object",
                  "required": [
                    "content",
                    "type"
                  ],
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "main-subject",
                        "profile"
                      ]
                    }
                  }
                }
              },
              "writing_type": {
                "type": "string",
                "const": "resumes",
                "default": "resumes",
                "x-user-visible": false
              },
              "storage_form": {
                "type": "string",
                "const": "markdown",
                "default": "markdown",
                "x-user-visible": false
              },
              "resume_profile": {
                "type": "string",
                "x-user-visible": false
              }
            }
          },
          "uiSchema": {
            "experience_raw": {
              "ui:widget": "textarea",
              "ui:options": {
                "rows": 8
              }
            },
            "job_description": {
              "ui:widget": "textarea",
              "ui:options": {
                "rows": 4
              }
            }
          },
          "prompt": {
            "unifiedTemplate": "【角色】你是资深 IT 简历写作顾问。根据结构化画像撰写**完整简历 Markdown 成稿**（不是 JSON，不是版式说明）。\n\n【结构化画像 resumeProfile】\n${resume_profile}\n\n【意向岗位】${target_roles}\n【职级】${seniority}\n【教育】${education}\n【技术栈】${tech_stack}\n【其他技术栈】${tech_stack_other}\n【原始经历】\n${experience_raw}\n【过往项目】\n${past_projects}\n【目标 JD】${job_description}\n\n【写作要求】\n1. 输出 Markdown：含 # 姓名/标题、## 各章节（简介、经历、项目、技能等）。\n2. 项目章节优先使用过往项目与 structured projects；量化成果、动词开头、对齐目标岗位；禁止虚构。\n3. 不写 CSS/多栏/封面/排版指令（Post 步负责 PDF 版式）。\n4. 只输出 Markdown 正文。"
          },
          "extra": {
            "generateParams": {
              "temperature": 0.45,
              "maxTokens": 12000
            }
          },
          "pipeline": {
            "pre": [
              {
                "step": "nestedText",
                "nestedTextTaskKey": "text/structure/resume-it-profile",
                "params": {
                  "outputStatePath": "pipeline.resumeProfile"
                },
                "inputMapping": {
                  "target_roles": "${params.target_roles}",
                  "seniority": "${params.seniority}",
                  "education": "${params.education}",
                  "tech_stack": "${params.tech_stack}",
                  "experience_raw": "${params.experience_raw}",
                  "job_description": "${params.job_description}",
                  "tech_stack_other": "${params.tech_stack_other}",
                  "past_projects": "${params.past_projects}"
                }
              }
            ],
            "post": [
              {
                "step": "renderDocumentPdf",
                "layoutTaskKey": "text/layout/document-render-spec",
                "params": {
                  "layoutTaskKey": "text/layout/document-render-spec",
                  "fallbackRenderer": "markdown",
                  "maxRetries": 2,
                  "validateSchema": "documentRenderSpec.v1"
                },
                "inputMapping": {
                  "markdown": "${state.coreArtifact.text}",
                  "structured": "${state.pipeline.resumeProfile}",
                  "renderer": "${params.pdf_renderer}",
                  "design_style": "${params.design_style}",
                  "profile_photo": "${params.profile_photo}"
                }
              }
            ]
          }
        }
      },
      "routing": {
        "logical_model": "writing-resumes-it",
        "provider": "jiekou",
        "model": "deepseek-v3",
        "enabled": true,
        "sensitive_word_lists": []
      },
      "businessPricing": [
        {
          "business_type": "writing-resumes-it",
          "charge_metric": "per_request",
          "price_in_tokens": 180,
          "min_charge_tokens": 0,
          "provider": "jiekou",
          "model_key": "deepseek-v3",
          "subtype": "it",
          "metadata": {
            "margin": 0.2
          }
        }
      ],
      "linkedTextFormat": null
    }
  ]
}
