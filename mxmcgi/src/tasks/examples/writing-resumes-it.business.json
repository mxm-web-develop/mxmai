          "userFacing": false,
          "taskLabelI18n": {
            "zh": "内部 · 排版",
            "zh-TW": "內部 · 排版"
          },
          "subtypeLabelI18n": {
            "zh": "文档渲染规格",
            "zh-TW": "文電子郵件渲染规格"
          }
        },
        "taskTemplate": {
          "formSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "markdown",
              "renderer",
              "design_style"
            ],
            "properties": {
              "markdown": {
                "type": "string",
                "title": "成稿 Markdown",
                "minLength": 1
              },
              "structured": {
                "type": "string",
                "title": "结构化 JSON 字符串"
              },
              "renderer": {
                "type": "string",
                "enum": [
                  "markdown",
                  "styled",
                  "html"
                ],
                "default": "styled"
              },
              "design_style": {
                "type": "string",
                "title": "设计风格"
              },
              "assets": {
                "type": "string",
                "title": "资源 JSON"
              }
            }
          },
          "prompt": {
            "unifiedTemplate": "【角色】你是 PDF 版式编排编辑。只生成 RenderSpec JSON，禁止改写正文内容。\n\n【renderer】${renderer}\n【design_style】${design_style}\n【assets】${assets}\n\n【structured】\n${structured}\n\n【markdown 成稿 — 仅用于 contentBinding，禁止 paraphrase】\n${markdown}\n\n【规则】\n1. 输出 JSON：{\"documentRenderSpec\":{version,page,theme,assets,blocks}, \"documentLayoutHtml\":\"可选\"}。\n2. version 固定 \"1\"；page.size=A4；theme.paletteId 与 design_style 一致。\n3. blocks 可含 cover/toc/section/markdown/highlights/image/twoColumn/spacer。\n4. 正文块使用 contentBinding:\"markdown\" 或 structured 字段，禁止内联长文本。\n5. profile 照片引用 assets 中 id=profile_photo。\n6. renderer=markdown 时禁止 twoColumn 与 page.backgroundImage；renderer=html 可更丰富。\n7. 只输出 JSON，无 Markdown 代码块。"
          },
          "extra": {
            "generateParams": {
              "temperature": 0.25,
              "maxTokens": 16384
            }
          }
        }
      },
      "routing": {
        "logical_model": "text-layout-document-render-spec",
        "provider": "maxplan",
        "model": "MiniMax-M3",
        "enabled": true,
