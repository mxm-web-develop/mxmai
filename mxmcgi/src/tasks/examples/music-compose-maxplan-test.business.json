{
  "schemaVersion": 1,
  "kind": "mxm-business-bundle",
  "exportedAt": "2026-06-30T00:00:00.000Z",
  "items": [
    {
      "scope": "text",
      "type": "transform",
      "subtype": "music-lyrics-draft",
      "is_active": true,
      "rules_i18n": {
        "zh": "",
        "en": ""
      },
      "output_format_i18n": {
        "zh": "",
        "en": ""
      },
      "form_options_i18n": null,
      "extra": {
        "display": {
          "taskLabel": "转换 · 音乐歌词创作",
          "subtypeLabel": "根据源材料与风格生成完整歌词（音乐管线内部，供 lyrics 传入）",
          "taskLabelI18n": {
            "zh": "转换 · 音乐歌词创作",
            "zh-TW": "轉換 · 音樂歌敏感詞創我的創作"
          },
          "subtypeLabelI18n": {
            "zh": "根据源材料与风格生成完整歌词（音乐管线内部，供 lyrics 传入）",
            "zh-TW": "根據源材料與风格產生完整歌敏感詞（音樂管線內部，供 lyrics 上傳入）"
          }
        },
        "taskTemplate": {
          "formSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "source_material",
              "music_style"
            ],
            "properties": {
              "source_material": {
                "type": "string",
                "title": "源材料",
                "description": "用户粘贴或虚拟文件夹召回的原始文本 / 主题",
                "minLength": 1
              },
              "music_style": {
                "type": "string",
                "title": "音乐风格",
                "enum": [
                  "pop",
                  "cinematic",
                  "lofi",
                  "electronic",
                  "folk"
                ],
                "x-enum-labels": [
                  "流行",
                  "影视",
                  "Lo-Fi",
                  "电子",
                  "民谣"
                ],
                "default": "pop"
              },
              "language": {
                "type": "string",
                "title": "歌词语言",
                "enum": [
                  "zh",
                  "en"
                ],
                "x-enum-labels": [
                  "中文",
                  "英文"
                ],
                "default": "zh"
              },
              "supplement": {
                "type": "string",
                "title": "补充要求",
                "description": "可选：情绪、主题、押韵、段落结构提示等"
              }
            }
          },
          "prompt": {
            "unifiedTemplate": "【角色】你是资深作词人，擅长把零散材料写成可直接演唱的完整歌词。\n\n【源材料 / 主题】\n${source_material}\n\n【音乐风格】${music_style}\n（pop=朗朗上口、影视=史诗氛围、lofi=慵懒叙事、electronic=律动重复、folk=质朴叙事）\n\n【歌词语言】${language}（zh=中文，en=英文）\n\n【补充要求】${supplement}\n\n【任务】\n1. 紧扣源材料的核心意象与情绪，写一首结构完整、可演唱的歌词。\n2. 使用段落标记组织结构：[Verse]、[Chorus]、[Bridge]、[Outro]（副歌至少出现两次，主歌 2~3 段）。\n3. 每行一句，句子长度适中、有韵律感；避免生僻字与拗口表达。\n4. 严格按【歌词语言】输出全部歌词。\n\n【输出格式（严格遵守）】\n- 只输出歌词正文与段落标记，逐行换行。\n- **禁止**输出标题、曲风描述、乐器/节奏说明、解释、JSON、Markdown 代码块、以及「以下是」「好的」等任何前缀。"
          },
          "extra": {
            "generateParams": {
              "temperature": 0.7,
              "maxTokens": 4096
            }
          }
        }
      },
      "routing": {
        "logical_model": "text-transform-music-lyrics-draft",
        "provider": "maxplan",
        "model": "MiniMax-M3",
        "enabled": true,
        "sensitive_word_lists": []
      },
      "businessPricing": [
        {
          "business_type": "text-transform-music-lyrics-draft",
          "charge_metric": "per_request",
          "price_in_tokens": 15,
          "min_charge_tokens": 0,
          "provider": "maxplan",
          "model_key": "MiniMax-M3",
          "subtype": "music-lyrics-draft",
          "metadata": {
            "margin": 0.2,
            "internal": true
          }
        }
      ],
      "linkedTextFormat": null
    },
    {
