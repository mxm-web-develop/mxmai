        },
        "taskTemplate": {
          "formSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "source_text": {
                "type": "string",
                "title": "粘贴描述/歌词意向",
                "description": "直接描述想要的音乐，或粘贴歌词意向",
                "x-ui-type": "text"
              },
              "source_ref": {
                "type": "object",
                "title": "虚拟文件夹召回",
                "description": "从已向量化虚拟文件夹召回相关文本片段",
                "x-ui-type": "kbRecall",
                "x-resolve-phase": "pre",
                "x-auto-from": "source_text",
                "properties": {
                  "folderId": {
                    "type": "string",
                    "title": "虚拟文件夹"
                  },
                  "query": {
                    "type": "string",
                    "title": "召回问题",
                    "description": "描述你想从文件夹里找什么；可留空则使用下方粘贴文本"
                  },
                  "limit": {
                    "type": "integer",
                    "default": 12,
                    "minimum": 1,
                    "maximum": 20,
                    "x-user-visible": false
                  }
                }
              },
              "music_style": {
                "type": "string",
                "title": "音乐风格",
                "x-ui-type": "selection",
                "enum": [
                  "pop",
                  "cinematic",
                  "lofi",
                  "electronic",
                  "folk"
                ],
                "x-enum-labels": [
                  "流行",
                  "影视",
                  "Lo-Fi",
                  "电子",
                  "民谣"
                ],
                "default": "pop"
              },
              "lyrics": {
                "type": "string",
                "title": "完整歌词（可选）",
                "description": "若填写则优先作为 lyrics 传入模型"
              },
              "make_instrumental": {
                "type": "boolean",
                "title": "纯器乐",
                "default": false
              },
              "supplement": {
                "type": "string",
                "title": "补充要求",
                "description": "可选：情绪、节奏、乐器等"
              },
              "total_duration_seconds": {
                "type": "integer",
                "title": "预估时长（秒，计费参考）",
                "minimum": 1,
                "default": 60,
                "x-user-visible": false
              }
            }
          },
          "uiSchema": {
            "source_text": {
              "ui:widget": "textarea",
              "ui:options": {
                "rows": 8
              }
            },
            "lyrics": {
              "ui:widget": "textarea",
              "ui:options": {
                "rows": 6
              }
            },
            "supplement": {
              "ui:widget": "textarea",
              "ui:options": {
                "rows": 3
              }
            }
          },
          "prompt": {
            "unifiedTemplate": "【描述/意向】\n${source_text}\n\n【虚拟文件夹召回】\n${source_ref}\n\n【风格】${music_style}\n【补充】${supplement}\n\n【歌词（若已填）】\n${lyrics}"
          },
          "storage": {
            "scope": "music",
            "extension": "mp3",
            "mime": "audio/mpeg",
            "pathTemplate": "{userId}/music/{timestamp}-{randomId}/",
            "filenameTemplate": "music_{taskId}_{randomId}.mp3"
          }
        }
      },
      "routing": {
        "logical_model": "music-compose-maxplan-direct",
        "provider": "maxplan",
        "model": "music-2.6",
        "enabled": true,
