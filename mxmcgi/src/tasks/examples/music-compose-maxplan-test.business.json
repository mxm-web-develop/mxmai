      },
      "businessPricing": [
        {
          "business_type": "music-compose-maxplan-direct",
          "charge_metric": "per_audio_second",
          "price_in_tokens": 2,
          "min_charge_tokens": 30,
          "provider": "maxplan",
          "model_key": "music-2.6",
          "subtype": "maxplan-direct",
          "metadata": {
            "margin": 0.25
          }
        }
      ],
      "linkedTextFormat": null
    },
