          "pipeline": {
            "pre": [
              {
                "step": "nestedText",
                "nestedTextTaskKey": "text/transform/music-lyrics-draft",
                "params": {
                  "afterPromptRender": true,
                  "outputTarget": "lyrics"
                },
                "when": {
                  "all": [
                    {
                      "field": "params.make_instrumental",
                      "op": "falsy"
                    },
                    {
                      "field": "params.is_instrumental",
                      "op": "falsy"
                    },
                    {
                      "field": "params.lyrics",
                      "op": "empty"
                    }
                  ]
                },
                "inputMapping": {
                  "source_material": "${params.source_text}\n\n${params.source_ref}",
                  "music_style": "${params.music_style}",
                  "language": "${params.language}",
