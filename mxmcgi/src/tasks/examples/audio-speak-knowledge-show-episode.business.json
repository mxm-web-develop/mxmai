                "type": "string",
                "title": "结束语·感谢句",
                "default": "感谢你的陪伴。",
                "maxLength": 100
              },
              "closing_cta_enabled": {
                "type": "boolean",
                "title": "包含一键三连话术",
                "description": "关闭则该段不出现在结束语中",
                "default": true
              },
              "closing_cta": {
                "type": "string",
                "title": "一键三连话术（自定义）",
                "description": "缺省话术：「如果觉得本期内容对你有帮助，请帮我点赞、投币、收藏三连；点一下关注不迷路。」",
                "default": "如果觉得本期内容对你有帮助，请帮我点赞、投币、收藏三连；点一下关注不迷路。",
                "maxLength": 200
              },
