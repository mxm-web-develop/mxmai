            }
          },
          "prompt": {
            "unifiedTemplate": "【占位 - 主业务由 text/transform/knowledge-show-script-draft + manualReview + text/transform/knowledge-show-script-tts-markup 三段 pipeline 产出最终口播稿。\n\n节目身份：\n节目名：${show_name}\n主播：${host_name}\n节目语言：${language}\n节目语气基调：${show_tone}\n\n开场：${opening_greeting}\n源材料：${source_material}\n补充：${supplement}\n\n此模板仅作 ctx 引用占位，最终 prompt 由 pre.3 段流水线赋值。】"
          },
          "storage": {
            "scope": "audio",
            "extension": "mp3",
            "mime": "audio/mpeg",
            "pathTemplate": "{userId}/audio/show/{timestamp}-{randomId}/",
            "filenameTemplate": "show_{taskId}_{randomId}.mp3"
          },
          "pipeline": {
            "pre": [
              {
                "step": "nestedText",
                "nestedTextTaskKey": "text/transform/knowledge-show-script-draft",
                "params": { "afterPromptRender": true },
                "inputMapping": {
                  "show_name": "${params.show_name}",
                  "host_name": "${params.host_name}",
                  "language": "${params.language}",
                  "show_tone": "${params.show_tone}",
                  "opening_greeting": "${params.opening_greeting}",
                  "closing_thanks": "${params.closing_thanks}",
                  "closing_cta_enabled": "${params.closing_cta_enabled}",
                  "closing_cta": "${params.closing_cta}",
                  "closing_next_episode": "${params.closing_next_episode}",
                  "source_material": "${params.source_material}",
                  "supplement": "${params.supplement}"
                }
              },
              {
                "step": "manualReview",
                "params": {
                  "id": "show-episode-script-review",
                  "label": "节目稿审核（开场·主稿·结束语）",
                  "hint": "可调整开场欢迎、主稿内容、结束语一键三连话术；确认后进入 TTS 优化与合成。",
                  "kind": "text",
                  "draftFrom": "${state.finalPrompt}",
                  "applyMapping": {
                    "prompt": "${review.text}"
                  }
                }
              },
              {
                "step": "nestedText",
                "nestedTextTaskKey": "text/transform/knowledge-show-script-tts-markup",
                "params": { "afterPromptRender": true },
                "inputMapping": {
                  "script_draft": "${state.finalPrompt}",
                  "voice_id": "${params.voice_id}",
                  "show_tone": "${params.show_tone}",
                  "speech_rhythm": "${params.speech_rhythm}",
                  "language": "${params.language}"
                }
              }
            ]
          },
          "extra": {
            "subtitle_enable": true
          }
        }
      },
      "routing": {
        "logical_model": "audio-speak-knowledge-show-episode",
        "provider": "maxplan",
        "model": "speech-2.8-hd",
        "enabled": true,
        "sensitive_word_lists": []
      },
      "businessPricing": [
        {
          "business_type": "audio-speak-knowledge-show-episode",
          "charge_metric": "per_audio_second",
          "price_in_tokens": 2,
          "min_charge_tokens": 30,
          "provider": "maxplan",
          "model_key": "speech-2.8-hd",
          "subtype": "knowledge-show-episode",
          "metadata": { "margin": 0.25, "show": true }
        }
      ],
      "linkedTextFormat": null
    }
  ]
}
