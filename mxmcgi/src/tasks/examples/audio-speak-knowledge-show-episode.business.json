                "x-ui-type": "selection",
                "enum": [
                  "steady",
                  "editorial",
                  "narrative",
                  "explanatory",
                  "lively",
                  "passionate"
                ],
                "x-enum-labels": [
                  "沉稳理性",
                  "评论思辨",
                  "故事叙事",
                  "教练拆解",
