              "intel_web": {
                "type": "object",
                "title": "联网检索",
                "description": "选填；留空检索问题时自动以「品牌/客户」为主题检索",
                "x-ui-type": "webSearch",
                "x-auto-from": "field:brand_name",
                "x-context-max-chars": 8000,
                "x-max-items": 3,
                "properties": {
                  "searchDepth": {
                    "type": "string",
                    "title": "检索深度",
                    "enum": [
                      "quick",
                      "standard",
                      "deep"
                    ],
                    "x-enum-labels": [
                      "快速",
                      "标准",
                      "深度"
                    ],
                    "default": "deep"
                  },
                  "query": {
                    "type": "string",
                    "title": "检索问题"
                  },
                  "maxResults": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 15,
                    "x-user-visible": false
                  }
                }
              },
              "intel_kb": {
                "type": "object",
                "title": "知识库召回",
                "description": "选填：从虚拟文件夹召回品牌资料、历史稿件",
                "x-ui-type": "kbRecall",
                "x-max-items": 3,
                "properties": {
                  "folderId": {
                    "type": "string",
                    "title": "虚拟文件夹"
                  },
                  "query": {
                    "type": "string",
                    "title": "召回问题"
                  },
                  "limit": {
                    "type": "integer",
                    "default": 8,
                    "minimum": 1,
                    "maximum": 20,
                    "x-user-visible": false
