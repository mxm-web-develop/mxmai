              "supplement": {
                "type": "string",
                "title": "补充说明",
                "description": "选填：必须覆盖的章节、竞品参照、禁用表述、特殊货盘要求等",
                "x-ui-type": "textarea"
              },
              "reference_materials": {
                "type": "string",
                "title": "参考资料",
                "description": "选填：粘贴或上传 .txt · .md · .pdf，或从虚拟文件夹选取（品牌手册、货盘清单、历史方案）",
                "x-ui-type": "textFileOrPaste",
