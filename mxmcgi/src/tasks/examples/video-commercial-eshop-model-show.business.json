{
  "schemaVersion": 1,
  "kind": "mxm-business-bundle",
  "exportedAt": "2026-05-28T00:00:00.000Z",
  "items": [
    {
      "scope": "video",
      "type": "generator",
      "subtype": "eshop-i2v",
      "is_active": true,
      "form_options_i18n": null,
      "extra": {
        "display": {
          "taskLabel": "生成",
          "subtypeLabel": "上架图动效",
          "routeHint": "默认单张首帧图生视频（Smartflow 自动传入上架图）；也可开启宫格分镜，上传 2×2/3×3/4×4 分镜源图走多参考成片",
          "taskLabelI18n": {
            "zh": "生成",
            "zh-TW": "產生"
          },
          "subtypeLabelI18n": {
            "zh": "上架图动效",
            "zh-TW": "上架圖啟動效"
          }
        },
        "taskTemplate": {
          "formSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "motion_preset",
              "uid"
            ],
            "properties": {
              "hero_still_images": {
                "type": "array",
                "title": "首帧（上架图）",
                "description": "单张首帧图生视频模式使用。来自 graph/eshop 的成片静帧；Smartflow 由上一节点自动填入。开启宫格分镜时请留空。",
                "x-ui-type": "referenceImages",
                "minItems": 0,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "content",
                    "type"
                  ],
                  "properties": {
                    "content": {
                      "type": "string",
                      "title": "图片 URL / Base64"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "main-subject"
                      ],
                      "default": "main-subject"
                    },
                    "purpose": {
                      "type": "string",
                      "title": "用途说明（可选）"
                    }
                  }
                }
              },
              "storyboard_grid": {
                "type": "object",
                "title": "宫格分镜图（可选）",
                "description": "开启后上传单张 2×2 / 3×3 / 4×4 分镜宫格源图，自动识别白缝裁切为多 reference_images（reference-to-video）。与「首帧」二选一。",
                "x-ui-type": "gridStoryboardImages",
                "x-supports-last-frame": true,
                "default": {
                  "enabled": false,
                  "layout": "2x2",
                  "auto_detect_layout": true,
                  "source_image": null,
                  "cells": [],
                  "first_frame_index": 0,
                  "last_frame_index": null
                },
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": false
                  },
                  "layout": {
                    "type": "string",
                    "enum": [
                      "2x2",
                      "3x3",
                      "4x4"
                    ],
                    "default": "2x2"
                  },
                  "auto_detect_layout": {
                    "type": "boolean",
                    "default": true
                  },
                  "source_image": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "content": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "default": "main-subject"
                      }
                    }
                  },
                  "cells": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "index": {
                          "type": "integer"
                        },
                        "purpose": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "first_frame_index": {
                    "type": "integer",
                    "default": 0
                  },
                  "last_frame_index": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "x-user-visible": true
              },
              "product_title": {
                "type": "string",
                "title": "品牌 / 商品名（可选）",
                "description": "用于运镜节奏与氛围（如轻奢、运动、童装），不写则仅按首帧与运镜预设生成。",
                "maxLength": 120,
                "x-user-visible": true
              },
              "motion_preset": {
                "type": "string",
                "title": "运镜 / 展示预设",
                "description": "控制分镜节奏与镜头运动，突出版型与面料可读性。",
                "x-ui-type": "selection",
                "enum": [
                  "gentle_turn",
                  "walk_in_place",
                  "detail_chest",
                  "hem_sway",
                  "runway_step"
                ],
                "x-enum-labels": [
                  "缓慢转身 · 三向版型",
                  "轻步 / 垂坠摆围",
                  "胸腰推近 · 结构细节",
                  "低机位 · 下摆摆动",
                  "T 台小步 · 主图视频感"
                ],
                "default": "gentle_turn",
                "x-user-visible": true
              },
              "scene_style": {
                "type": "string",
                "title": "场景 / 光感",
                "x-ui-type": "selection",
                "enum": [
                  "taobao_clean",
                  "studio_soft",
                  "lifestyle_indoor"
                ],
                "x-enum-labels": [
                  "货架白底 · 高 key",
                  "柔和棚拍 · 面料质感",
                  "简约室内 · 品牌生活感"
                ],
                "default": "taobao_clean",
                "x-user-visible": true
              },
              "prompt": {
                "type": "string",
                "title": "分镜 / 品牌补充（可选）",
                "description": "卖点、禁止项、品牌调性（如「偏轻奢慢节奏」「强调领口细节」）等；不写则完全由运镜预设驱动。",
                "x-ui-type": "textarea",
                "x-user-visible": true
              },
              "duration": {
                "type": "integer",
                "title": "时长（秒）",
                "minimum": 4,
                "maximum": 15,
                "default": 5,
                "x-user-visible": true
              },
              "ratio": {
                "type": "string",
                "title": "画幅",
                "enum": [
                  "9:16",
                  "1:1",
                  "16:9",
                  "adaptive"
                ],
                "default": "9:16",
                "x-user-visible": true
              },
              "resolution": {
                "type": "string",
                "title": "分辨率",
                "enum": [
                  "480p",
                  "720p",
                  "1080p"
                ],
                "default": "720p",
                "x-user-visible": true
              },
              "generate_audio": {
                "type": "boolean",
                "title": "生成环境音",
                "default": false,
                "x-user-visible": true
              },
              "total_duration_seconds": {
                "type": "integer",
                "title": "计费时长（秒）",
                "minimum": 1,
                "default": 5,
                "x-user-visible": false
              },
              "parallel_count": {
                "type": "integer",
                "title": "生成份数",
                "minimum": 1,
                "maximum": 9,
                "default": 1,
                "x-user-visible": true
              },
              "label": {
                "type": "string",
                "title": "任务名称",
                "x-user-visible": true
              },
              "uid": {
                "type": "string",
                "title": "任务 UID",
                "x-user-visible": false
              }
            }
          },
          "uiSchema": {
            "hero_still_images": {
              "ui:options": {
                "maxFiles": 1
              }
            },
            "prompt": {
              "ui:widget": "textarea",
              "ui:options": {
                "rows": 4
              }
            }
          },
          "prompt": {
            "unifiedTemplate": "【电商上架图 · 动效短片】\n\n本任务承接 graph/eshop 上架静帧或宫格分镜源图：人物与服装已在参考中确定。你的职责是**分镜、运镜与节奏**，让版型、面料与品牌调性在 ${duration} 秒内清晰可读——不是换模特、不是改款、不是重新搭配。\n\n品牌/商品（可选语境）：${product_title}\n运镜预设：${motion_preset}\n场景光感：${scene_style}\n画幅 ${ratio}，约 ${duration} 秒，${resolution}。\n\n【参考守恒（硬）】\n- 人物身份、服装款式/配色/关键结构（领、袖、腰、下摆/裤长）与参考一致。\n- 动作为**展示级**轻微运动；禁止夸张舞蹈、换装、镜头跳切、多场景硬切。\n\n【宫格分镜（若启用）】\n${storyboard_prompt}\n\n【运镜预设 · 分镜要点】\n- gentle_turn：稳定 eye-level，缓慢转身展示前/侧/后版型；服装始终占画面主体。\n- walk_in_place：短步或原地轻踏，强调垂坠、摆围与裤脚/裙摆动态。\n- detail_chest：可控推近至胸腰 hero，领口/门襟/腰线可读，浅景深但不糊结构。\n- hem_sway：略低机位，下摆/裙摆随微动轻摆，适合裙裤类。\n- runway_step：干净背景小步向前，主图视频/详情头图气质，利落不浮夸。\n\n【场景光感】\n- taobao_clean：高 key 白/浅灰底，无杂物、无水印 Logo，信息密度适合货架。\n- studio_soft：柔侧光，面料微反差，偏品牌 lookbook。\n- lifestyle_indoor：简约室内，人物服装仍为主体，道具不抢戏。\n\n【分镜 / 品牌补充】\n${prompt}\n\n输出：可上架电商展示短片；电影感克制；服装细节可读；无文字贴纸、无平台水印。"
          },
          "storage": {
            "scope": "video",
            "extension": "mp4",
            "mime": "video/mp4",
            "bucket": "user-media",
            "pathTemplate": "{userId}/video/{timestamp}-{randomId}/",
            "filenameTemplate": "eshop_showcase_{taskId}_{randomId}.mp4"
          }
        }
      },
      "linkedTextFormat": null
    }
  ]
}
