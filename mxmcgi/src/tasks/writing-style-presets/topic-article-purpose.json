    {
      "id": "fiction_short",
      "label": {
        "zh": "短篇网文·完整故事",
        "zh-TW": "短篇網文·完整故事",
        "en": "Short fiction (complete)",
        "ja": "短編小説（完結）"
      },
      "lengths": [
        {
          "id": "brief",
          "label": {
            "zh": "短篇",
            "zh-TW": "短篇",
            "en": "Short",
            "ja": "短編"
          },
          "min_chars": 2000,
          "model_guide": {
            "zh": "短篇：目标约2000–3500汉字。一场戏打完欲望→冲突→反转→落点；场面优先，禁止写成几百字意境小品。",
            "en": "Short: ~2000–3500 Chinese chars; one complete scene-arc with visible action."
          }
        },
        {
          "id": "standard",
          "label": {
            "zh": "中篇",
            "zh-TW": "中篇",
            "en": "Medium",
            "ja": "中編"
          },
          "min_chars": 3500,
          "model_guide": {
            "zh": "中篇：目标约3500–5500汉字（不得明显短于3500）。现状与回放都要有可感场面与对话，禁止只靠旁白跳切。",
            "en": "Medium: ~3500–5500 Chinese chars; present + flashback need staged scenes."
          }
        },
        {
          "id": "long",
          "label": {
            "zh": "长篇（一次读完）",
            "zh-TW": "長篇（一次讀完）",
            "en": "Long (one sitting)",
            "ja": "長編（一回読了）"
          },
          "min_chars": 5500,
          "model_guide": {
            "zh": "长篇：目标约5500–8000汉字（仍一次读完，非连载）。加厚人物关系与关键场面，禁止「未完」。",
            "en": "Long one-sitting: ~5500–8000 chars; thicken scenes; no serialization."
          }
        }
      ],
