    {
      "id": "cn_cold_irony",
      "region": "cn_mainland",
      "label": {
        "zh": "鲁迅式冷峭",
        "zh-TW": "魯迅式冷峭",
        "en": "Cold irony (Lu Xun–esque)",
        "ja": "冷峭な皮肉調"
      },
      "blurb": {
        "zh": "短句刺点，反讽压着写，不煽情喊口号",
        "zh-TW": "短句刺點，反諷壓著寫，不煽情喊口號",
        "en": "Short thrusts, irony under pressure; no slogans",
        "ja": "短い刺、抑えめの皮肉。スローガン禁止"
      },
      "craft": {
        "sentence": "短句为主；转折用「然而／却／不过」；少排比少感叹号",
        "stance": "冷眼看机制与群像；嘲讽对事不对人身攻击",
        "opening": "常从一件具体小事或一个刺耳判断切入，再扩到更大结构",
        "avoid": "鸡汤、热血口号、emoji、网感堆梗、抒情排比",
        "lexicon": "喜用反问、贬义雅词、冷色动词"
      },
      "referenceParagraph": {
        "zh": "街上都在谈风口。风口是什么？是把人吹上天之前，先把人吹成纸片的那种风。",
        "zh-TW": "街上都在談風口。風口是什麼？是把人吹上天之前，先把人吹成紙片的那種風。",
        "en": "Everyone talks about the next windfall. A windfall is a wind that shreds people into paper before it lifts them.",
        "ja": "みんなが「追い風」と言う。追い風とは、人を舞い上げる前に紙きれにする風のことだ。"
      }
    },
    {
      "id": "cn_plain_warm",
      "region": "cn_mainland",
      "label": {
