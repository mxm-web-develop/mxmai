# 基础服务配置
PORT=4002
SQLITE_DB_PATH=mxmpay.sqlite
PAYMENT_EXPIRE_MINUTES=20

# PostgreSQL 配置（可选）
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=password
PG_DB=postgres

# Alipay（包含收款账户）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_SELLER_LOGON_ID=

# WeChat Pay（包含收款账户）
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_RECEIVER_MCH_ID=
WECHAT_RECEIVER_APPID=

# PayPal（包含收款账户）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_MERCHANT_ID=

# Card（以 Stripe 为例）
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=

# Crypto 多链钱包
# 优先使用 CRYPTO_WALLETS 提供 JSON 配置；未提供时使用后备单变量
# CRYPTO_WALLETS={"eth":{"native":"0x...","erc20":{"usdt":"0x...","usdc":"0x..."}},"tron":{"trc20":{"usdt":"T..."}},"btc":{"native":"bc1..."},"bsc":{"bep20":{"usdt":"0x..."}},"sol":{"spl":{"usdc":"..."}}}

CRYPTO_ETH_ADDRESS=
CRYPTO_ERC20_USDT_ADDRESS=0x30fa6f5ca1644324f649745a82af25e62f370904
CRYPTO_ERC20_USDC_ADDRESS=
CRYPTO_TRON_TRC20_USDT_ADDRESS=TFB7nmdys6xCwfQDbRcppZtLh6Nc9afJxa
CRYPTO_BTC_ADDRESS=
CRYPTO_BSC_USDT_ADDRESS=
CRYPTO_SOL_USDC_ADDRESS=

# 区块链监听服务配置
# 监听类型: local | alchemy | infura
LISTENER_TYPE=local

# 启用区块链监听服务
ENABLE_BLOCKCHAIN_LISTENER=false

# 本地监听服务配置（LISTENER_TYPE=local 时使用）
ETH_RPC_URL=https://eth.llamarpc.com
TRON_RPC_URL=https://api.trongrid.io
POLL_INTERVAL=10000

# Alchemy 配置（LISTENER_TYPE=alchemy 时使用）
ALCHEMY_API_KEY=

# Infura 配置（LISTENER_TYPE=infura 时使用）
INFURA_PROJECT_ID=
INFURA_PROJECT_SECRET=

ADMIN_TOKEN=your-admin-test-token-here

# Webhook 回调地址（所有监听类型都需要）
WEBHOOK_URL=http://localhost:3001/payment/webhook/crypto

SUPABASE_URL=http://localhost:8000
