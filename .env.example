# =============================================================================
# SuperMXMai 统一环境变量（复制为 .env，勿提交 git）
# 可选：.env.local 覆盖本机差异（已 gitignore）
# 文档：docs/ENV.md  |  迁移：node scripts/merge-env-to-root.mjs
# =============================================================================

# ---------- 共享：数据库 / 认证 / 存储 ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
# SUPABASE_DB_URL=postgresql://...

JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=57600
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
JWT_CLOCK_TOLERANCE_SECONDS=120
ADMIN_TOKEN=your-admin-token

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=true

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

# ---------- 三块对象存储（与香港一致：MinIO 三桶）----------
# 桶名：aigc / user-assets / system-assets（勿用下划线）；本地执行 pnpm ensure:buckets
CGI_STORAGE_BUCKET=aigc
STORAGE_GENERATED_PROVIDER=minio
STORAGE_GENERATED_BUCKET=aigc
STORAGE_GENERATED_ACCESS=proxy

STORAGE_USER_UPLOAD_PROVIDER=minio
STORAGE_USER_UPLOAD_BUCKET=user-assets
# proxy=鉴权 Gateway 代理；public=经 Gateway 公网可读（大模型可拉参考图）；presigned=预签名直链
STORAGE_USER_UPLOAD_ACCESS=public

STORAGE_SYSTEM_STATIC_PROVIDER=minio
STORAGE_SYSTEM_STATIC_BUCKET=system-assets
STORAGE_SYSTEM_STATIC_ACCESS=public

STORAGE_USER_TEMP_TTL_DAYS=7
# STORAGE_USER_TEMP_TTL_MINUTES=15
# STORAGE_OBJECT_CLEANUP_INTERVAL_MS=300000
# MinIO 预签名（外网需 MINIO 可被访问或配合反代）：
# STORAGE_USER_UPLOAD_ACCESS=presigned
# STORAGE_USER_UPLOAD_PRESIGNED_TTL_SECONDS=604800

PUBLIC_GATEWAY_ORIGIN=http://localhost:3000
PUBLIC_GATEWAY_ABSOLUTE_URLS=1

# 可选：仍保留 R2 凭证时仅作 legacy 双读（新写入已走 MinIO，一般不需要）
# R2_BUCKET=user-assets
# R2_SYSTEMTEMP_BUCKET=systemtemp
# R2_PUBLIC_URL=https://pub-xxx.r2.dev
# R2_ENDPOINT=accountid.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_REGION=auto

# 阿里云 OSS（STORAGE_*_PROVIDER=aliyun_oss 时启用）
# OSS_REGION=cn-hangzhou
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_PUBLIC_URL=

# ---------- 各服务端口（必填，勿使用单一 PORT=）----------
GATEWAY_PORT=3000
MXMAUTH_PORT=4001
MXMPAY_PORT=4002
MXMCGI_PORT=4003
WORKER_PORT=4004
SCHEDULER_PORT=4006
MXMNOTIFY_PORT=4005

# ---------- Gateway ----------
CORS_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:5173,http://localhost:5174
MXMAUTH_URL=http://localhost:4001
MXMPAY_URL=http://localhost:4002
MXMCGI_URL=http://localhost:4003
MXMNOTIFY_URL=http://localhost:4005
# GATEWAY_TASKS_V2_PROXY_TIMEOUT_MS=600000

# ---------- mxmauth ----------
# 图形验证码（svg-captcha + Redis）；H5/账户登录发码前校验，生产建议 true
CAPTCHA_ENABLE=false
BCRYPT_ROUNDS=10

# 站点公网 URL（验证邮件 / 重置密码 / OAuth 回跳前端）
APP_PUBLIC_URL=http://localhost:5173
# OAuth 回调基址（经 Gateway，生产填 https://mxm-ai.com）
OAUTH_REDIRECT_BASE=http://localhost:3000

# SMTP（阿里云邮件推送等；注册验证与重置密码必需）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MXM AI <noreply@mail.mxm-ai.com>"

# Google / GitHub OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# TOTP 两步验证（可选；未设 MFA_ENCRYPTION_KEY 时用 JWT_SECRET 派生）
# MFA_ENCRYPTION_KEY=
# MFA_TOTP_ISSUER=SuperMXM
# MFA_CHALLENGE_TTL_SEC=300
# MFA_MAX_ATTEMPTS=5

# ---------- mxmpay ----------
# ENABLE_TASK_PAYMENT=false
# PG_HOST=localhost

# ---------- mxmcgi ----------
# GSAP 动画片段 mp4 渲染（可选；未配置时 worker 本机 Playwright + ffmpeg 内联渲染）
# GSAP_RENDER_ENDPOINT=http://127.0.0.1:4010
# GSAP_RENDER_PORT=4010
# GSAP_RENDER_MAX_CONCURRENT=1
# GSAP_REVIEW_MAX_CONCURRENT=1
# VIDEO_EDIT_CLIP_CONCURRENCY=2
MXMCGI_ROLE=all
MXMNOTIFY_URL=http://localhost:4005
# MXMCGI_INTERNAL_TOKEN=change-me-in-production
# WORKER_ID=worker-1
# WORKER_MAX_CONCURRENT=2
# WORKER_CLAIM_BATCH=10
# WORKER_IDLE_POLL_MS=30000
# WORKER_POLLER_ENABLED=true
# TASK_QUEUE_REDIS_KEY=cgi:task:queue
# AGENT_TASK_WAIT_TIMEOUT_MS=120000
# TASK_WAIT_POLL_MS=3000
DEFAULT_PROVIDER=maxplan
DEFAULT_MODEL=MiniMax-M3

# AI Provider Keys（按需）
# REPLICATE_API_TOKEN=
# DEERAPI_API_KEY=          # 已下架，仅兼容历史任务
# DEERAPI_BASE_URL=
# QHAI_API_KEY=             # 启航 AI https://www.qhaigc.net/docs/quickstart
# QHAI_BASE_URL=https://api.qhaigc.net/v1
# JIEKOU_API_KEY=           # 接口AI https://docs.jiekou.ai/docs/support/quickstart
# JIEKOU_BASE_URL=https://api.highwayapi.ai
# Knowledge Embedding（推荐 Admin 配置；以下为 fallback）
# EMBEDDING_MODEL=qwen3-embedding-8b
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_PROVIDER=jiekou
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ATLASCLOUD_API_KEY=
# MAXPLAN_API_KEY=

# 代理（可选）
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# R2 / 搜索 / 其他 mxmcgi 配置见原 mxmcgi/.env.example 注释项
# R2_BUCKET=mxmtemimageref
# R2_PUBLIC_URL=https://pub-xxx.r2.dev
# R2_ENDPOINT=accountid.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_SYSTEMTEMP_BUCKET=systemtemp
# R2_SYSTEMTEMP_PUBLIC_URL=https://pub-xxx-systemtemp.r2.dev

# ---------- mxmnotify ----------
DEBUG=false

# ---------- Partner H5 短信登录（mxmauth，阿里云号码认证·短信认证）----------
# 开发可 PARTNER_SMS_MOCK=true，验证码固定 123456
# PARTNER_SMS_MOCK=false
# PARTNER_SMS_PROVIDER=aliyun_pnvs
# ALIYUN_PNVS_ACCESS_KEY_ID=
# ALIYUN_PNVS_ACCESS_KEY_SECRET=
# ALIYUN_PNVS_SIGN_NAME=速通互联验证码
# ALIYUN_PNVS_TEMPLATE_CODE=100001
# ALIYUN_PNVS_TEMPLATE_MIN=5
# PARTNER_SMS_OTP_TTL_SEC=300
# PARTNER_SMS_COOLDOWN_SEC=60
# PARTNER_SMS_DAILY_MAX=10

# ---------- E2E / Web ----------
BASE_URL=http://localhost:3000
GATEWAY_BASE=http://localhost:3000
AGENT_API_BASE=http://localhost:4003
# TEST_EMAIL=admin@test.com
# TEST_PASSWORD=password

# ---------- 搜索引擎（Admin DB 优先；未配 DB 时读环境变量）----------
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# ANYSEARCH_API_KEY=          # https://anysearch.com/console/api-keys
# BING_API_KEY=
# BOCHA_API_KEY=
# SERPAPI_API_KEY=

# ---------- 免费图库（素材引用 / 参考图，多源混合检索）----------
# PEXELS_API_KEY=          # https://www.pexels.com/api/
# UNSPLASH_ACCESS_KEY=     # https://unsplash.com/developers
# PIXABAY_API_KEY=         # https://pixabay.com/api/docs/
# Openverse 无需 Key，未配置上述项时仍可检索 CC 授权图片
