  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "TSUP_ENTRY=src/index.ts tsup --config ../tsup.config.ts --out-dir dist",
    "start": "node dist/index.js",
    "playground:langchain": "tsx src/playground/01-langchain-basic.ts",
    "playground:langraph": "tsx src/playground/02-langraph-workflow.ts",
    "playground:vector": "tsx src/playground/03-vector-database.ts",
    "playground:optimizer": "tsx src/playground/04-prompt-optimizer.ts",
    "playground:all": "pnpm playground:langchain && pnpm playground:langraph && pnpm playground:vector && pnpm playground:optimizer"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.1.3",
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.0.2",
    "@langchain/openai": "^1.1.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "langchain": "^1.1.1",
    "tsx": "^4.7.0",
    "zod": "^4.1.13"
  }
